# Smart Labo Works — 環境変数サンプル
# このファイルをコピーして .env を作成し、実際のAPIキーを設定してください
# .env は絶対にGitHubにコミットしないこと

# ========================================
# OpenAI
# ========================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ========================================
# Claude (AI Router v1.0 対応済み)
# ========================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# ========================================
# Gemini (将来追加)
# ========================================
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.0-flash

# ========================================
# Whisper (将来追加)
# ========================================
# WHISPER_MODEL=whisper-1

# ========================================
# 認証（Task3で追加。最小構成）
# 現時点は単一企業・単一ユーザーのみ対応。CompanyIDは固定値で運用する
# ========================================
# AUTH_COMPANY_ID=default
# AUTH_EMAIL=your-email@example.com
#
# AUTH_PASSWORD_HASH は "salt:hash" 形式（node crypto.scryptSync）。以下のコマンドで生成できる:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
# AUTH_PASSWORD_HASH=

# ========================================
# アプリ設定
# ========================================
PORT=3006
AI_MODE=openai
