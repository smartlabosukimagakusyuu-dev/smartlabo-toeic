// ===================================================
// Firestore セキュリティルール
//
// 【適用方法】
// Firebase コンソール → Firestore → ルール に貼り付けて「公開」
//
// セキュリティ設計:
//  - ユーザーは自分のドキュメントのみ読み書き可能
//  - isPremium の書き込みはサーバー（Cloud Functions）のみ許可
//  - 他のユーザーのデータへのアクセスは完全に禁止
// ===================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== users コレクション =====
    match /users/{userId} {

      // 自分のドキュメントのみ読み込み可能
      allow read: if request.auth != null && request.auth.uid == userId;

      // 新規作成: ログイン済みユーザーが自分のドキュメントを作成可能
      // ただし isPremium は false のみ許可（サーバーのみ true に変更可能）
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.isPremium == false
                    && request.resource.data.uid == userId;

      // 更新: uid と email のみユーザーが変更可能
      //       isPremium の更新はサーバー（Cloud Functions = admin SDK）のみ許可
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !('isPremium'  in request.resource.data.diff(resource.data).affectedKeys())
                    && !('premiumAt'  in request.resource.data.diff(resource.data).affectedKeys())
                    && !('stripeSessionId' in request.resource.data.diff(resource.data).affectedKeys());

      // 削除: 禁止
      allow delete: if false;
    }

    // その他のコレクションはすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
